    <string name="auto_install_intro">Glidr installs the PC app for you. Your PC must be unlocked and online.</string>
    <string name="install_step_1">Glidr opens the Run box on your PC (Win+R).</string>
    <string name="install_step_2">It types a short command that downloads GlidrCompanion.exe.</string>
    <string name="install_step_3">The app starts and a Glidr icon appears in the tray.</string>
    <string name="install_step_4">Windows may ask you to confirm. Needs the .NET 8 Desktop Runtime.</string>
